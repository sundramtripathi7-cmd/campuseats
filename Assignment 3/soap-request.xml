<?xml version="1.0" encoding="UTF-8"?>

<soap:Envelope
    xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:pay="http://campuseats.example.com/payment">

    <soap:Header>
        <pay:Credentials>
            <pay:merchantId>CE_MERCHANT_001</pay:merchantId>
            <pay:apiKey>DEMO_API_KEY_123</pay:apiKey>
        </pay:Credentials>
    </soap:Header>

    <soap:Body>
        <pay:charge>
            <pay:orderId>ORD1001</pay:orderId>
            <pay:amount>499.00</pay:amount>
            <pay:currency>INR</pay:currency>
            <pay:paymentToken>tok_demo_123</pay:paymentToken>
        </pay:charge>
    </soap:Body>

</soap:Envelope>