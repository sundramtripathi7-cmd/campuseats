# CampusEats Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
CAMPUSEATS_TOKEN=campuseats-demo-token
JWT_SECRET=campuseats-super-secret-jwt-key-2026
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT=20
RATE_WINDOW_SECONDS=60

# Database Configuration (MySQL)
STORE_BACKEND=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campuseats_db

# External Payment Service URL (if running standalone)
PAYMENTS_URL=http://127.0.0.1:8080

